{#
/**
 * @file
 * Default theme implementation for a network view.
 *
 * Available variables:
 * - attributes: HTML attributes for the wrapper.
 * - canvas_attributes: HTML attributes for the graph container, including the
 *   graph data in data-network-views.
 * - legend: The legend, with optional keys:
 *   - nodes: List of node categories, each with label, color and count.
 *   - edges: List of edge types, each with label, color and count.
 *
 * @ingroup themeable
 */
#}
<div{{ attributes }}>
  <div{{ canvas_attributes }}></div>
  {% if legend %}
    <div class="network-views__legend">
      {% for group, items in legend %}
        <ul class="network-views__legend-list network-views__legend-list--{{ group }}">
          {% for item in items %}
            <li class="network-views__legend-item">
              <span class="network-views__swatch network-views__swatch--{{ group }}" style="--network-views-swatch: {{ item.color }}"></span>
              {{ item.label }} <span class="network-views__count">({{ item.count }})</span>
            </li>
          {% endfor %}
        </ul>
      {% endfor %}
    </div>
  {% endif %}
</div>
